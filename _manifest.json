{
  "manifest_version": 2,
  "id": "github.nethielchou.mai-fx-sim",
  "version": "0.3.4",
  "plugin_type": "game",
  "name": "麦麦炒外汇",
  "description": "让麦麦在群聊里用自己的判断交易一个本地虚拟外汇账户：零售 FX 规则（虚拟人民币计价、默认 10 倍杠杆、1 万货币、强制平仓、隔夜利息、点差/滑点），真实公开行情，纯娱乐模拟盘，不接真实交易通道、不构成投资建议。",
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png",
      "fallback": "coins",
      "background": "#1F3A5F"
    }
  },
  "author": {
    "name": "NethielChou",
    "url": "https://github.com/NethielChou"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/NethielChou/maibot-fx-sim",
    "homepage": "https://github.com/NethielChou/maibot-fx-sim",
    "documentation": "https://github.com/NethielChou/maibot-fx-sim/blob/main/README.md",
    "issues": "https://github.com/NethielChou/maibot-fx-sim/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.13",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.21.0",
    "max_version": "2.22.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.forward",
    "llm.generate",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "message.get_recent",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
